{
    "name": "certdrift",
    "version": "0.0.1",
    "license": "MIT",
    "type": "module",
    "description": "Inspect, check and compare X.509 certificates from the terminal or as a library.",
    "keywords": [
        "x509",
        "certificate",
        "tls",
        "ssl",
        "mtls",
        "pem",
        "pki",
        "expiry",
        "diff",
        "cli"
    ],
    "homepage": "https://github.com/mantoniocc/certdrift#readme",
    "bugs": {
        "url": "https://github.com/mantoniocc/certdrift/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mantoniocc/certdrift.git"
    },
    "author": "Mario Cortés",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./src/index.js"
        },
        "./tls": {
            "types": "./types/tls/index.d.ts",
            "default": "./src/tls/index.js"
        },
        "./schema/*": "./schema/*.json"
    },
    "bin": {
        "certdrift": "./bin/certdrift.js"
    },
    "types": "./types/index.d.ts",
    "files": [
        "src/",
        "bin/",
        "schema/",
        "types/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm test",
        "build:types": "tsc -p tsconfig.types.json",
        "prepack": "npm run build:types",
        "fixtures": "bash test/fixtures/generate.sh"
    },
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "@types/node": "^24.13.6",
        "ajv": "^8.20.0",
        "typescript": "^7.0.2"
    }
}
