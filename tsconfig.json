{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "bin/**/*.js", "test/**/*.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "experiments", "tmp"]
}